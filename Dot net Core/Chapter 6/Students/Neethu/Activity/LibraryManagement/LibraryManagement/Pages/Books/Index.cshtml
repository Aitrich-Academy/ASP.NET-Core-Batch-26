@page "/"
@model LibraryManagement.Pages.Books.IndexModel
@{
    ViewData["Title"] = "Book List";

}
<h1>@ViewData["Title"]</h1>

<form method="get">
    <div class="form-group">
        <input type="text" name="search" class="form-control" placeholder="Search by Title" value="@Model.Search" />
    </div>
    <button type="submit" class="btn btn-primary mt-2">Search</button>
</form>

<p>Total Books: @Model.TotalCount</p>

<p>
    <a asp-page="Create">Add New Book</a>
</p>

@if(Model.BookList!=null&&Model.BookList.Any())
{
    <table class="table">
        <thead>
            <tr>
                <th>Title</th>
                <th>Genre</th>
                <th>Author</th>
                <th>PublishDate</th>
            </tr>
        </thead>
        <tbody>
            @foreach(var item in Model.BookList)
            {
                <tr>
                    <td>@item.Title</td>
                    <td>@item.Genre</td>
                    <td>@item.Author</td>
                    <td>@item.PublishDate</td>
                    <td>
                        <a asp-page="Edit" asp-route-id="@item.BookId">Edit</a>
                        <a asp-page="Details" asp-route-id="@item.BookId">Details</a>
                        <a asp-page="Delete" asp-route-id="@item.BookId">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>Book not Found</p>
}