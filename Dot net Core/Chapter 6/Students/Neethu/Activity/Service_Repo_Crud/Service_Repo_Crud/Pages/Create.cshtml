@page
@model Service_Repo_Crud.Pages.CreateModel
@{
    ViewData["Title"] = "Add Book";
}

<h1>Add A Book</h1>

<hr />
<div class="row">
    <div class=" col-md-4">
        <form method="post">
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="NewBook.Title" class="control-label"></label>
                <input asp-for="NewBook.Title" class="form-control" />
                <span asp-validation-for="NewBook.Title" class="text-danger"></span>
            </div>

            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="NewBook.Genre" class="control-label"></label>
                <input asp-for="NewBook.Genre" class="form-control" />
                <span asp-validation-for="NewBook.Genre" class="text-danger"></span>
            </div>

            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="NewBook.Author" class="control-label"></label>
                <input asp-for="NewBook.Author" class="form-control" />
                <span asp-validation-for="NewBook.Author" class="text-danger"></span>
            </div>

            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="NewBook.PublishDate" class="control-label"></label>
                <input asp-for="NewBook.PublishDate" class="form-control" />
                <span asp-validation-for="NewBook.PublishDate" class="text-danger"></span>
            </div>

            <div class="form-group">
                <button type="submit" class="btn btn-primary">Save</button>
                <a asp-page="Index" class="btn btn-secondary">Cancel</a>
            </div>

        </form>

    </div>
</div>
<p>@Model.Message</p>