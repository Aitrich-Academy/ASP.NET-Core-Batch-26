@page
@model Razor_Workshop.Pages.Jobs.DetailsModel
@{
    ViewData["Title"] = "Title";
}
<div>
<h4>Job Details</h4>
<hr>
<table class="table table-dark table-primary">
    <tr>
    <td class="col-sm-2">Job Title</td>
    <td class="col-sm-10">@Model.JobPost.JobTitle</td>
    </tr>
    <tr>
    <td class="col-sm-2">Company</td>
    <td class="col-sm-10">@Model.JobPost.Company</td>
    </tr>
    <tr>
    <td class="col-sm-2">Location</td>
    <td class="col-sm-10">@Model.JobPost.Location</td>
    </tr>
    <tr>
    <td class="col-sm-2">Employment type</td>
    <td class="col-sm-10">@Model.JobPost.EmploymentType</td>
    </tr>
    <tr>
    <td class="col-sm-2">Salary Range</td>
    <td class="col-sm-10">@Model.JobPost.SalaryRange</td>
    </tr>
    
    <tr>
        <td class="col-sm-2">Job Description</td>
        <td class="col-sm-10">@Model.JobPost.JobDescription</td>
    </tr>
    <tr>
        <td class="col-sm-2">Requirements</td>
        <td class="col-sm-10">@Model.JobPost.Requirements</td>
    </tr>

    </table>
</div>