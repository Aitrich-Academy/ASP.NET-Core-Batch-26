@page "/"
@model Razor_Workshop.Pages.Jobs.IndexModel
@{
    ViewData["Title"] = "Index";
}
<h2>Job Listing</h2>
<a asp-page="Create" class="btn btn-primary mb-3">Create New Job</a>
<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>Job Title</th>
            <th>Company</th>
            <th>Location</th>
            <th>Employment Type</th>
            <th>Salary Range</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var job in Model.Jobposts)
        {

            <tr>
                <td>@job.JobTitle</td>
                <td>@job.Company</td>
                <td>@job.Location</td>
                <td>@job.EmploymentType</td>
                <td>@job.SalaryRange</td>
                <td>
                    <a asp-page="Edit" asp-route-id="@job.Id" class="btn btn-warning btn-sm">Edit</a>
                    <a asp-page="Details" asp-route-id="@job.Id" class="btn btn-info btn-sm">Details</a>
                    <a asp-page="Delete" asp-route-id="@job.Id" class="btn btn-danger btn-sm">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
