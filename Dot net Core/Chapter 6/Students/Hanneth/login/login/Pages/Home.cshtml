@page
@model login.Pages.HomeModel
@{
    ViewData["Title"] = "Home";
}
<h2>@Model.WelcomeMessage</h2>
@if(Model.isLoggedIn)
{
    <form method="post" asp-page-handler="Logout">
        <button type="submit">Logout</button>

    </form>
}
else
{
    <a href="/Register">Register</a>
    <a href="/Login">Login</a>
}

