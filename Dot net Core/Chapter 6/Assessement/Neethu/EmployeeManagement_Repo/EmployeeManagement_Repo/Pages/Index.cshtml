@page "/"
@model EmployeeManagement_Repo.Pages.IndexModel
@{
    ViewData["Title"] = "EmplyeeManagement";
}
<h2>Emplyee Management System</h2>

<form method="post">
    <input type="text" asp-for="@Model.Search" placeholder="Search by Designation" name="Search"  />
    <button type="submit" class="btn btn-primary">Search</button>
</form>
<p>Total Count:@Model.TotalCount</p>

<p><a asp-page="Create" class="btn btn-primary">Add Employee</a></p>

@if(Model.employees!=null)
{
    <table class="table-bordered">
        <thead class="table-dark text-white text-center">
            <tr>
                <th>Employee Name:</th>
                <th>Designation:</th>
                <th>Salary:</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach(var item in Model.employees)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.Designation</td>
                    <td>@item.Salary</td>
                    <td>
                        <a asp-page="Details" class="btn btn-warning" asp-route-id="@item.Id">View</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>Not found</p>
}

