@page "/Edit/{Id}"

@inject ApplicationDbContext applicationDbContext
@inject NavigationManager navigationManager

<head>
    Edit Book
</head>
<hr />

<div class="row">
    <div class="col-md-4">
        <form @onsubmit="Update">
            <div class="form-group">
                <span class="text-danger">*</span>
                <label for="Title" class="control-label">Title</label>
                <input id="Title" class="form-control" @bind="book.Title" />
            </div>

            <div class="form-group">
                <span class="text-danger">*</span>
                <label for="Author" class="control-label">Author</label>
                <input id="Author" class="form-control" @bind=book.Author />
            </div>

            <div class="form-group">
                <button class="mt-3 btn btn-primary" type="submit">Update</button>
            </div>

            <div>
                <NavLink class="nav-link" href="/">Back to List</NavLink>
            </div>
        </form>
    </div>
</div>
@code {
    [Parameter]
    public string Id { get; set; }
    private Book book = new Book();
    protected override void OnInitialized()
    {
        book = GetBookById(Convert.ToInt32(Id));
    }
    protected void Update()
    {
        UpdateBook(book);
        navigationManager.NavigateTo("/");
    }
    public Book GetBookById(int id)
    {
        var book = applicationDbContext.bookss.FirstOrDefault(b => b.Id == id);
        return book;
    }
    public void UpdateBook(Book book)
    {
        applicationDbContext.bookss.Update(book);
        applicationDbContext.SaveChanges();
    }
}