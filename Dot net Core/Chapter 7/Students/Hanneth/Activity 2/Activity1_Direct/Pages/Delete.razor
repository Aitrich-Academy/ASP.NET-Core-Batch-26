@page "/Delete/{Id}"
@inject ApplicationDbContext applicationDbContext
@inject NavigationManager navigationManager
<h3>Delete book</h3>

<hr />
<div class="row">
    <div class="col-md-4">
        <p class="text-danger">Are you sure you want to delete this?</p>
        <div class="row">
            <div class="col-md-8">
                <form onsubmit="DeleteBook">
                    <label for="Id" class="control-label">Book Id : @bookList.Id</label>
                    <label for="Title" class="control-label">Title : @bookList.Title</label>
                    <label for="Author" class="control-label">Author : @bookList.Author</label>
                    <button class="btn btn-danger" type="submit">Delete</button>
                    <br />
                    <br />
                    <a class="btn btn-primary" href="/Display">Show List</a>
                </form>
            </div>

        </div>
    </div>

</div>

@code {
    [Parameter]
    public string Id { get; set; }
    Book bookList = new Book();
    protected override void OnInitialized()
    {
        bookList = GetBookById(Convert.ToInt32(Id));
    }
    public Book GetBookById(int id)
    {
        var book = applicationDbContext.bookss.FirstOrDefault(b => b.Id == id);
        return book;
    }
    protected void DeleteBook()
    {
        DeleteBook(bookList.Id);
        navigationManager.NavigateTo("/");
    }

    public void DeleteBook(int id)
    {
        var book = applicationDbContext.bookss.Find(id);
        if (id != null)
        {
            applicationDbContext.bookss.Remove(book);
            applicationDbContext.SaveChanges();
        }
    }
}
