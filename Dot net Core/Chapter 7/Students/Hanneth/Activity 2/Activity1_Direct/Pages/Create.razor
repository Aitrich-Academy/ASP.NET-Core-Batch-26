@page "/Create"
@using System.Collections
@inject ApplicationDbContext applicationDbContext
@inject NavigationManager navigationManager
<h3>Add Book</h3>


<hr />

<div class="row">
    <div class="col-md-4">
        <form @onsubmit="Add">
            <div class="form-group">
                <span class="text-danger">*</span>
                <label for="Title" class="control-label">Title</label>
                <input id="Title" class="form-control" @bind="bookList.Title" />
            </div>

            <div class="form-group">
                <span class="text-danger">*</span>
                <label for="Author" class="control-label">Author</label>
                <input id="Author" class="form-control" @bind=bookList.Author />
            </div>

            <div class="form-group">
                <button class="mt-3 btn btn-primary" type="submit">Add Book</button>
            </div>

            <div>
                <NavLink class="nav-link" href="/">Back to List</NavLink>
            </div>
        </form>
    </div>
</div>
@code
{
    Book bookList = new Book();
    protected void Add()
    {
        AddBook(bookList);
        navigationManager.NavigateTo("/");
    }
    public void AddBook(Book book)
    {
        applicationDbContext.bookss.Add(book);
        applicationDbContext.SaveChanges();
    }
}
