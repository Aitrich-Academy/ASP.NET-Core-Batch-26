@page "/"
@inject IProductService _Service
@inject NavigationManager navigationManager


<PageTitle>Index</PageTitle>

<div class="container mt-4">
    <h2 class="text-center text-danger"> Welcome to Inventory Management System!</h2>

</div>
<div>
    <EditForm Model="@filterModel" OnValidSubmit="Filtering">
        <label>Filter By Category</label><span><button type="submit" class="btn btn-success text-center">Filter</button></span>
        <select class="form-control" @bind="filterModel.FilterCategory">
            <option value="Electronics">Electronics</option>
            <option value="Fashion">Fashion</option>
            <option value="Furniture">Furniture</option>
            <option value="Cosmetics">Cosmetics</option>
            <option value="Appliances">Appliances</option>
        </select>

        
        
    </EditForm>
</div>
<br />


@if(products==null)
{
    <div class="text-center">
        <div class="spinner-border text-primary" role="status">
            <span class="sr-only">Loading...</span>
        </div>
    </div>
}
else
{
    
    <div class="table-responsive">
        <table class="table table-bordered table-hover">
            <thead class="table-dark text-center">
               <tr>
                   <th>Product Name:</th>
                   <th>Category:</th>
                   <th>Quantity:</th>
                   <th>Price:</th>
                   <th>Status:</th>
                   <th>Actions:</th>
               </tr>
            </thead>
            <tbody>
                @foreach (var prod in products)
                {
                    <tr>
                        <td>@prod.ProdName</td>
                        <td>@prod.Category</td>
                        <td>@prod.Quantity</td>
                        <td>@prod.Price</td>
                        <td class="@(prod.Quantity==0?"text-danger":"text-success")">
                            @(prod.Quantity==0?"Out of Stock":"In stock")
                        </td>
                        <td>
                            <button class="btn btn-warning btn-sm me-2" @onclick="()=>EditProduct(prod)">Edit</button>
                            <button class="btn btn-danger btn-sm " @onclick="()=>DeleteProduct(prod.ProductId)">Delete</button>
                        </td>

                    </tr>
                }
            </tbody>
        </table>

    </div>
    <div class="card mt-4 shadow">
        <div class="card-header bg-primary text-white text-center">
            <h3>@(editproduct.ProductId==0?"Add Product":"Edit Product")</h3>
        </div>
        <div class="card-body">
            <EditForm Model="@editproduct" OnValidSubmit="SaveProduct">
                <DataAnnotationsValidator/>
                <div class="mb-3">
                    <label class="form-label fw-bold">Product Name:</label>
                    <InputText class="form-control" @bind-Value="editproduct.ProdName"/>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Category:</label>
                    <select class="form-control" @bind="editproduct.Category">
                        <option value="Electronics">Electronics</option>
                        <option value="Fashion">Fashion</option>
                        <option value="Furniture">Furniture</option>
                        <option value="Cosmetics">Cosmetics</option>
                        <option value="Appliances">Appliances</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Quantity:</label>
                    <InputNumber class="form-control" @bind-Value="editproduct.Quantity" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Price:</label>
                    <InputNumber class="form-control" @bind-Value="editproduct.Price" />
                </div>

                <div class="text-center">
                    <button type="submit" class="btn btn-success">Save</button>
                </div>
            </EditForm>
        </div>
    </div>
   
}
@code
{
    private List<Product> products;
    //private string filter;
    private Product editproduct = new();

    public class FilterModel
    {
        public string FilterCategory { get; set; }
    }
    private FilterModel filterModel = new();
    protected override async Task OnInitializedAsync()
    {
        products = await _Service.GetAllProductsAsync();
    }

    private async Task SaveProduct()
    {
        if(editproduct.ProductId==0)
        {
            await _Service.AddProductAsync(editproduct);
        }
        else
        {
            await _Service.UpdateProductAsync(editproduct);
        }
        products = await _Service.GetAllProductsAsync();
        editproduct = new();
    }
    private async Task EditProduct(Product product)
    {
        var existing = await _Service.GetProductByIdAsync(product.ProductId);
        if (existing != null)
        {
            existing.ProdName = product.ProdName;
            existing.Category = product.Category;
            existing.Quantity = product.Quantity;
            existing.Price = product.Price;
        }
        editproduct = existing;

    }
    private async Task DeleteProduct(int id)
    {
        await _Service.DeleteProductAsync(id);
        products = await _Service.GetAllProductsAsync();
    }

    private async Task Filtering()
    {
        products = await _Service.GetProductsByCategoryAsync(filterModel.FilterCategory);
    }

}

