@model List<Crud_MVC.Models.Student>

    <h2>Student List</h2>
    <a href="/Student/Create">Add New</a>
    <table border="1">
    <tr>
        <th>Id</th>
        <th>Name</th>
        <th>Age</th>
        <th>Actions</th>
    </tr>
    @foreach(var item in Model)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.Name</td>
            <td>@item.Age</td>
            <td>
                <a href="/Student/Edit/@item.Id">Edit</a>
                <a href="/Student/Delete/@item.Id">Delete</a>
            </td>
        </tr>
    }
</table>
